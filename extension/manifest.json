{
  "manifest_version": 3,
  "name": "Google Calendar Visualizer",
  "version": "0.1.0",
  "description": "Adds personalized visual backgrounds to Google Calendar events.",
  "content_scripts": [
    {
      "matches": ["https://calendar.google.com/*"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/test-background.png",
        "assets/church.png",
        "assets/lunch.png"
      ],
      "matches": ["https://calendar.google.com/*"]
    }
  ]
}